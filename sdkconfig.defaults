# Enable insecure TLS connections (skip certificate verification)
# For development/testing only
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# ========== ESP32-S3-N16R8 Hardware Configuration ==========
# Flash size: 16MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Enable 8MB Octal PSRAM (R8)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# ========== BLE Provisioning Configuration (NimBLE) ==========
# Enable Bluetooth
CONFIG_BT_ENABLED=y

# Use NimBLE stack (lighter than Bluedroid, saves memory)
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# NimBLE Configuration
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n

# Enable Wi-Fi Provisioning Manager
CONFIG_ESP_WIFI_PROV_ENABLED=y

# ========== Wi-Fi Configuration ==========
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# ========== Task Stack Size Configuration ==========
# Increase main task stack size for BLE provisioning
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Increase system event task stack size
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
